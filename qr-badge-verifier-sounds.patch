diff --git a/public/sounds.js b/public/sounds.js
new file mode 100644
--- /dev/null
+++ b/public/sounds.js
@@ -0,0 +1,43 @@
+(() => {
+  let context;
+  const Audio = window.AudioContext || window.webkitAudioContext;
+  const denied = new Set(['not_yet_valid', 'expired', 'cannot_verify', 'malformed', 'unsupported']);
+
+  function unlock() {
+    if (!Audio || !document.querySelector('#sound-enabled').checked) return;
+    try {
+      context ||= new Audio();
+      if (context.state !== 'running') context.resume().catch(() => {});
+    } catch { /* Sound is optional; the verification result remains visible. */ }
+  }
+
+  function tone(frequency, start, duration, waveform, volume) {
+    const oscillator = context.createOscillator();
+    const gain = context.createGain();
+    oscillator.type = waveform;
+    oscillator.frequency.setValueAtTime(frequency, start);
+    gain.gain.setValueAtTime(0.001, start);
+    gain.gain.linearRampToValueAtTime(volume, start + 0.018);
+    gain.gain.exponentialRampToValueAtTime(0.001, start + duration);
+    oscillator.connect(gain).connect(context.destination);
+    oscillator.start(start);
+    oscillator.stop(start + duration + 0.015);
+    oscillator.onended = () => { oscillator.disconnect(); gain.disconnect(); };
+  }
+
+  function play(result) {
+    if (!context || context.state !== 'running' || !document.querySelector('#sound-enabled').checked) return;
+    const start = context.currentTime + 0.01;
+    try {
+      if (result === 'valid') {
+        tone(740, start, 0.12, 'sine', 0.15);
+        tone(990, start + 0.14, 0.17, 'sine', 0.15);
+      } else if (denied.has(result)) {
+        tone(360, start, 0.18, 'triangle', 0.18);
+        tone(260, start + 0.20, 0.26, 'triangle', 0.18);
+      }
+    } catch { /* Audio cannot affect the displayed verification decision. */ }
+  }
+
+  window.BadgeSounds = { unlock, play };
+})();
diff --git a/test/sounds.test.js b/test/sounds.test.js
new file mode 100644
--- /dev/null
+++ b/test/sounds.test.js
@@ -0,0 +1,43 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { runInNewContext } from 'node:vm';
+
+const script = readFileSync(new URL('../public/sounds.js', import.meta.url), 'utf8');
+test('approval and denial are distinct; unknown verification outcomes stay silent', () => {
+  const played = [];
+  const checkbox = { checked: true };
+  class AudioContext {
+    state = 'suspended';
+    currentTime = 1;
+    destination = {};
+    resume() { this.state = 'running'; return Promise.resolve(); }
+    createOscillator() {
+      const note = { frequency: null, type: '' };
+      return {
+        frequency: { setValueAtTime(value) { note.frequency = value; } },
+        connect(destination) { return destination; },
+        start() { played.push(note); }, stop() {}, disconnect() {}
+      };
+    }
+    createGain() {
+      return { gain: { setValueAtTime() {}, linearRampToValueAtTime() {}, exponentialRampToValueAtTime() {} }, connect() {}, disconnect() {} };
+    }
+  }
+  const window = { AudioContext };
+  runInNewContext(script, { window, document: { querySelector: () => checkbox } });
+  window.BadgeSounds.unlock();
+  window.BadgeSounds.play('valid');
+  assert.deepEqual(played.map(note => note.frequency), [740, 990]);
+  played.length = 0;
+  for (const status of ['not_yet_valid', 'expired', 'cannot_verify', 'malformed', 'unsupported']) {
+    window.BadgeSounds.play(status);
+    assert.deepEqual(played.map(note => note.frequency), [360, 260]);
+    played.length = 0;
+  }
+  for (const status of ['connection_error', 'rate_limited', 'service_error']) window.BadgeSounds.play(status);
+  assert.equal(played.length, 0);
+  checkbox.checked = false;
+  window.BadgeSounds.play('valid');
+  assert.equal(played.length, 0);
+});
