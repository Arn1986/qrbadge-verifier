{
  "name": "qr-badge-verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "lint": "node --check server.js scripts/build.mjs src/worker.js src/protocol.js",
    "dev": "npm run build && node server.js",
    "start": "node server.js",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply qr-badge-verifier --local",
    "db:remote": "wrangler d1 migrations apply qr-badge-verifier --remote"
  },
  "dependencies": { "jsqr": "1.4.0" },
  "devDependencies": { "wrangler": "^4.141.0" }
}
