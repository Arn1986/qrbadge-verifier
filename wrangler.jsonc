{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "qr-badge-verifier",
	"main": "src/worker.js",
	"compatibility_date": "2026-09-25",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "qr-badge-verifier",
			"database_id": "0f918f98-257c-4603-9492-74ef85bc1d4a"
		},
		{
			"binding": "qr_badge_verifier",
			"database_name": "qr-badge-verifier",
			"database_id": "0f918f98-257c-4603-9492-74ef85bc1d4a"
		}
	],
	"triggers": {
		"crons": [
			"0 2 * * *"
		]
	}
}