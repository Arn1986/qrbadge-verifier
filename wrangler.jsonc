{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qr-badge-verifier",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "qr-badge-verifier", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }
  ],
  "triggers": { "crons": ["0 2 * * *"] }
}
